# ---- Gemini ----------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# Leave empty to run in SIMULATED mode (token counts are estimates, for rehearsal only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: set to 0 to switch off "thinking" on 2.5 models for a cleaner comparison.
GEMINI_THINKING_BUDGET=

# Prices in USD per 1M tokens, used for the cost estimate. Check current Gemini pricing.
PRICE_INPUT_PER_M=0.30
PRICE_CACHED_INPUT_PER_M=0.03
PRICE_OUTPUT_PER_M=2.50

# ---- Supabase --------------------------------------------------------
# Project Settings -> API Keys -> Secret keys (sb_secret_...), or the legacy service_role key.
# It stays on the server, never in the browser.
# Leave empty to use built-in in-memory demo data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Server ----------------------------------------------------------
PORT=3000
